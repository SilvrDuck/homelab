[Unit]
Description=Restic backup of app configs and Obsidian vault to Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tibo
EnvironmentFile=/etc/homelab-backup.env
ExecStart=/bin/bash /home/tibo/homelab/infra/backup/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
