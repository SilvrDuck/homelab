# Template for /etc/obsidian-backup.env (loaded by obsidian-backup.service).
# Copy with sudo, fill in, then chmod 600.
#
#   sudo cp apps/obsidian/backup.env.dist /etc/obsidian-backup.env
#   sudo $EDITOR /etc/obsidian-backup.env
#   sudo chown root:root /etc/obsidian-backup.env
#   sudo chmod 600 /etc/obsidian-backup.env

# Restic repo URL via rclone backend. Replace `gdrive` with whatever you
# named the rclone remote during `rclone config`.
RESTIC_REPOSITORY=rclone:gdrive:homelab-backups/obsidian

# Repo passphrase. Generate fresh with:
#   openssl rand -base64 32 | tr -d '\n'
# Store the same value in your password manager. If you lose this you cannot
# decrypt the backups.
RESTIC_PASSWORD=

# Path to rclone config file. Default location for user `tibo`.
RCLONE_CONFIG=/home/tibo/.config/rclone/rclone.conf
